@inproceedings{10.1145/3812836.3814747,
author = {Li, Zhiying and Li, Tianxing},
title = {BlinkChat: Blink-Augmented Prompting for Adaptive Human–LLM Interaction},
year = {2026},
isbn = {9798400727122},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
html = {https://doi.org/10.1145/3812836.3814747},
doi = {10.1145/3812836.3814747},
abstract = {Current Large Language Models (LLMs) rely on explicit and user-initiated prompts for contextual adaptation, leaving passive user-state signals largely unexplored in interaction design. In contrast, using involuntary physiological signals as control channel for adaptive human-LLM interaction is relatively underexplored. In this extended abstract, we explore this idea by choosing human blinking as an involuntary physiological signal. We introduce BlinkChat, a prompting framework that encodes eye-blink activity as prompt. By locally integrating control tokens directly into the input stream, blink events are detected locally and injected during typing. This design does not modify any current user-LLM interaction dynamic nor transmit raw biometric data to the remote server. In terms of application, we consider blink frequency as a coarse proxy for cognitive strain, and a system-level prompt instructs the LLM to interpret and adjust response verbosity accordingly while preserving correctness. We evaluate this approach using 400 long-form prompts. Our simulation result shows task-dependent reductions in response length by up to 31.5\% at high blink rate (30 blink per minute), with compression effects strongest for short-answer factual tasks and attenuated for reasoning-intensive domains.},
highlight1 = {Explores involuntary eye blinks as an implicit input channel, using blink rate as a coarse proxy for cognitive strain to adapt LLM response verbosity.},
highlight2 = {Detects blinks locally and injects them as control tokens into the typing stream, leaving the chat workflow unchanged and sending no raw biometric data to the server.},
highlight3 = {Shortens responses by up to 31.5\% at high blink rates in simulations over 400 long-form prompts, strongest on short-answer factual tasks and attenuated on reasoning-heavy ones.},
booktitle = {Proceedings of the 24th Annual International Conference on Mobile Systems, Applications and Services Workshops},
pages = {151–153},
numpages = {3},
location = {University of Cambridge, Cambridge, United Kingdom},
venue = {MobiSys'26 (Workshop)},
selected = {true},
pdf = {3812836.3814747.pdf},
image = {/assets/img/pub_img/blinkChat.png},
}

@inproceedings{10.1145/3711875.3734565,
author = {Li, Zhiying and Aziz, Abdul and Do, Patrick Phuoc and Nguyen, Phuc and Li, Tianxing},
title = {Poster: MobiChem: A Ubiquitous Smartphone-Based Toolkit for Practical Fruit Monitoring and Analysis},
year = {2025},
isbn = {9798400714535},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
html = {https://doi.org/10.1145/3711875.3734565},
doi = {10.1145/3711875.3734565},
abstract = {This paper introduces MobiChem, a low-cost, portable, practical, and ubiquitous smartphone-based toolkit for fruit monitoring. The key idea is to leverage the light emitted from a smartphone's screen and front camera, coupled with a custom-built screen cover, to perform comprehensive hyperspectral analysis on targeted objects. Specifically, we designed a zero-powered screen cover that selectively filters wavelengths essential for hyperspectral sensing. We then incorporate a CNN-based algorithm and a novel ranking-based learning technique that manipulates the latent space to classify maturity stages and characterize their chemical and physical factors. We showcased its application in tomato, banana, and avocado sensing. Our system examines the maturity, chlorophyll, lycopene content, free sugar levels, and firmness, enabling various dietary assessments and food safety applications.},
highlight1 = {Uses the smartphone's own screen as the light source and its front camera as the sensor, enabling hyperspectral fruit analysis without extra active hardware.},
highlight2 = {Adds a zero-power screen cover that filters display light into the wavelength bands needed for hyperspectral sensing, keeping the toolkit low-cost and portable.},
highlight3 = {Estimates maturity, chlorophyll, lycopene, free sugar, and firmness for tomatoes, bananas, and avocados, targeting dietary assessment and food-safety applications.},
booktitle = {Proceedings of the 23rd Annual International Conference on Mobile Systems, Applications and Services},
pages = {605–606},
numpages = {2},
keywords = {fruit sensing, hyperspectral imaging, mobile sensing},
location = {Hilton Anaheim, Anaheim, CA, USA},
venue = {MobiSys '25 (Poster)},
selected = {true},
pdf = {3711875.3734565.pdf},
image = {/assets/img/pub_img/MobiChem_poster.png},
}

@inproceedings{10.1145/3711875.3729135,
author = {Li, Zhiying and Aziz, Abdul and Do, Patrick Phuoc and Nguyen, Phuc and Li, Tianxing},
title = {MobiChem: A Ubiquitous Smartphone-Based Toolkit for Practical Fruit Monitoring and Analysis},
year = {2025},
isbn = {9798400714535},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
html = {https://doi.org/10.1145/3711875.3729135},
doi = {10.1145/3711875.3729135},
abstract = {This paper introduces MobiChem, a low-cost, portable, practical, and ubiquitous smartphone-based toolkit for fruit monitoring. The key idea is to leverage the light emitted from a smartphone's screen and front camera, coupled with a custom-built screen cover, to perform comprehensive hyperspectral analysis on targeted objects. Specifically, we designed a zero-powered screen cover that selectively filters wavelengths essential for hyperspectral sensing. We then incorporate a CNN-based algorithm and a novel ranking-based learning technique that manipulates the latent space to classify maturity stages and characterize their chemical and physical factors. To demonstrate MobiChem's feasibility, robustness, and practicality, we showcase its application in tomato, banana, and avocado sensing. Our system examines the maturity, chlorophyll, lycopene content, free sugar levels, and firmness, enabling various dietary assessments and food safety applications. Experimental results using 117 tomatoes, 98 bananas, and 73 avocados show MobiChem achieved 95.67\% accuracy in chlorophyll concentration measurement, 98.76\% for lycopene detection, 93.53\% for sugar concentrations analysis, and 91.34\% average accuracy in classifying maturity (96.64\% for tomato, 86.37\% for banana, and 91.03\% for avocado).},
highlight1 = {Turns a commodity smartphone into a practical hyperspectral sensing platform using its screen, front camera, and a passive, zero-power optical filter cover.},
highlight2 = {Pairs a CNN with a ranking-based learning technique that shapes the latent space to classify maturity and estimate chemical and physical fruit properties.},
highlight3 = {Achieves 95.67\% accuracy for chlorophyll, 98.76\% for lycopene, 93.53\% for sugar concentration, and 91.34\% for maturity classification across 288 fruits.},
booktitle = {Proceedings of the 23rd Annual International Conference on Mobile Systems, Applications and Services},
pages = {1–14},
numpages = {14},
keywords = {fruit sensing, hyperspectral imaging, mobile sensing},
location = {Hilton Anaheim, Anaheim, CA, USA},
venue = {MobiSys'25},
selected = {true},
pdf = {3711875.3729135.pdf},
image = {/assets/img/pub_img/MobiChem.png},
}

@inproceedings{10.1145/3539494.3542757,
  author = {Li, Zhiying and Viswanath, Tejas and Yan, Zihan and Zhang, Yang},
  title = {SkinProfiler: Low-Cost 3D Scanner for Skin Health Monitoring with Mobile Devices},
  year = {2022},
  isbn = {9781450394062},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  url = {https://doi.org/10.1145/3539494.3542757},
  doi = {10.1145/3539494.3542757},
  abstract = {Melanoma is one of the top three most common skin cancers, originating from skin lesions and moles. Keeping track of skin lesion and mole developments in a precise and long-term manner has long been recommended but overlooked for the lack of accurate and easy-to-access tools. In response, we develop SkinProfiler, a low-cost mobile profiling tool for long-term skin health monitoring. To use SkinProfiler, users clamp an LED ring accessory onto smartphone cameras and take photos of the skin region of interest using the SkinProfiler app. Our modified photometric stereo algorithm leverages 17 photos taken with the skin surface lightened under various conditions to reconstruct 3D models of the skin surfaces. Our system stores 3D information for skin lesion and mole monitoring and diagnosis. The total cost of hardware assembly is under 20 dollars. We ran a preliminary evaluation to verify the performance of our tool. Based on the results, we propose several future steps including evaluations in clinical settings to complete this research.},
  highlight1 = {Targets long-term tracking of skin lesions and moles, a practice recommended for melanoma risk but often neglected for lack of accurate, accessible tools.},
  highlight2 = {Clamps an LED ring onto the phone camera to capture 17 photos under varied lighting, then reconstructs 3D skin-surface models with a modified photometric stereo algorithm.},
  highlight3 = {Keeps total hardware cost under 20 dollars; a preliminary evaluation verifies the tool's performance, with evaluation in clinical settings proposed as the next step.},
  booktitle = {Proceedings of the 2022 Workshop on Emerging Devices for Digital Biomarkers},
  pages = {1–6},
  numpages = {6},
  keywords = {skin health, smartphones, mobile health, photometric stereo},
  location = {Portland, Oregon},
  series = {DigiBiom '22},
  selected = {true},
  image = {/assets/img/pub_img/skinProfiler.png},
  html = {https://doi.org/10.1145/3539494.3542757},
  pdf = {SkinProfiler.pdf},
  slides = {SkinProfiler_slides_mobisys22.pdf},
  venue = {DigiBiom'22},
}
